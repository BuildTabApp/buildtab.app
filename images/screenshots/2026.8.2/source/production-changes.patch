diff --git a/BuildTabTests/AuditRegressionTests.swift b/BuildTabTests/AuditRegressionTests.swift
index e2e13b1..b6c7737 100644
--- a/BuildTabTests/AuditRegressionTests.swift
+++ b/BuildTabTests/AuditRegressionTests.swift
@@ -105,6 +105,40 @@ final class AuditRegressionTests: XCTestCase {
         XCTAssertFalse(defaults.bool(forKey: AppConstants.UserDefaultsKeys.iCloudSyncEnabled))
     }
 
+    func testResizingPreservesSelectedTabAndNavigationController() async throws {
+        let persistence = PersistenceController(defaults: defaults, inMemory: true)
+        let container = try XCTUnwrap(persistence.container)
+        let host = UIHostingController(rootView: ResizingNavigationHost().modelContainer(container))
+        let scene = try XCTUnwrap(UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }.first)
+        let window = UIWindow(windowScene: scene)
+        window.frame = scene.coordinateSpace.bounds
+        window.rootViewController = host
+        host.traitOverrides.horizontalSizeClass = .compact
+        window.makeKeyAndVisible()
+        defer { window.isHidden = true; window.rootViewController = nil }
+        try await Task.sleep(for: .milliseconds(300))
+
+        func descendants(of controller: UIViewController) -> [UIViewController] {
+            [controller] + controller.children.flatMap { descendants(of: $0) }
+        }
+        let tabs = try XCTUnwrap(descendants(of: host).compactMap { $0 as? UITabBarController }.first)
+        XCTAssertEqual(tabs.selectedIndex, 3)
+        let selected = try XCTUnwrap(tabs.selectedViewController)
+        try await Task.sleep(for: .milliseconds(200))
+        let navigation = try XCTUnwrap(descendants(of: selected).compactMap { $0 as? UINavigationController }.first)
+
+        for sizeClass in [UIUserInterfaceSizeClass.regular, .compact, .regular] {
+            host.traitOverrides.horizontalSizeClass = sizeClass
+            host.view.setNeedsLayout()
+            host.view.layoutIfNeeded()
+            try await Task.sleep(for: .milliseconds(200))
+            let currentTabs = try XCTUnwrap(descendants(of: host).compactMap { $0 as? UITabBarController }.first)
+            XCTAssertTrue(currentTabs === tabs, "Resizing replaced the tab hierarchy")
+            XCTAssertEqual(currentTabs.selectedIndex, 3)
+            XCTAssertTrue(descendants(of: host).contains { $0 === navigation }, "Resizing discarded the navigation stack")
+        }
+    }
+
